<section class="pr-diff"><style>.pr-diff { margin-top: 1.5rem; } .pr-diff h2 { color: #f0f6fc; font-size: 1.15rem; } .diff-file { margin-top: 1rem; border: 1px solid #30363d; border-radius: 6px; overflow: hidden; } .diff-file-header { display: flex; justify-content: space-between; padding: .6rem .85rem; background: #161b22; color: #f0f6fc; } .diff-file-header span { color: #8b949e; } .diff-lines { margin: 0; overflow: auto; background: #0d1117; } .diff-line { display: block; min-width: max-content; padding: 0 .85rem; font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre; } .diff-line.added { background: #12261e; color: #d2f5db; } .diff-line.removed { background: #321b1c; color: #ffdcd7; } .diff-line span { display: inline-block; width: 1.5rem; color: #8b949e; } .no-diff { padding: 1rem; color: #8b949e; border: 1px solid #30363d; border-radius: 6px; }</style><h2>Files changed</h2><% if changes.any? %><% changes.each do |change| %><article class="diff-file"><div class="diff-file-header"><strong><%= change.path %></strong><span><%= change_label(change) %></span></div><pre class="diff-lines"><code><% diff_lines(change).each do |action, line| %><span class="diff-line <%= action == "+" ? "added" : "removed" %>"><span><%= action %></span><%= line.chomp %></span><% end %></code></pre></article><% end %><% else %><p class="no-diff">No captured file changes exist between <strong><%= @pull_request.base_branch %></strong> and <strong><%= @pull_request.head_branch %></strong>.</p><% end %></section>
