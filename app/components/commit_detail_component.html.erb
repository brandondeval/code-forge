<!doctype html>
<html><head><title><%= @commit.message %> · <%= @repository.name %> · Forge</title><style>body { margin: 0; color: #c9d1d9; background: #0d1117; font: 16px/1.5 system-ui, sans-serif; } header { padding: 1rem max(5vw, 1.5rem); background: #161b22; border-bottom: 1px solid #30363d; } main { max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem; } a { color: #58a6ff; text-decoration: none; } h1 { color: #f0f6fc; font-size: 1.45rem; } .meta { color: #8b949e; } code { color: #58a6ff; } .file-diff { margin-top: 1rem; border: 1px solid #30363d; border-radius: 6px; overflow: hidden; } .file-header { display: flex; justify-content: space-between; padding: .6rem .85rem; background: #161b22; border-bottom: 1px solid #30363d; } .added { color: #3fb950; } pre { margin: 0; overflow: auto; background: #0d1117; } .diff-line { display: block; min-width: max-content; padding: 0 .85rem; font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: #12261e; color: #d2f5db; } .line-number { display: inline-block; width: 3rem; margin-right: 1rem; color: #6e7681; user-select: none; } .empty { padding: 1rem; color: #8b949e; border: 1px solid #30363d; border-radius: 6px; }</style></head><body><header><strong>◈ Forge</strong></header><main><a href="<%= repository_commits_path(@repository.owner.login, @repository.name, branch: @commit.branch) %>">← Commit history</a><h1><%= @commit.message %></h1><p class="meta"><code><%= @commit.sha %></code> · <%= @commit.branch %> · <%= time_ago_in_words(@commit.created_at) %> ago</p><% if changes.any? %><% changes.each do |change| %><section class="file-diff"><div class="file-header"><strong><%= change.path %></strong><span class="added">+ added</span></div><pre><code><% diff_lines(change).each_with_index do |line, index| %><span class="diff-line"><span class="line-number"><%= index + 1 %></span>+ <%= line.chomp %></span><% end %></code></pre></section><% end %><% else %><p class="empty">No file changes were captured for this commit.</p><% end %></main></body></html>
