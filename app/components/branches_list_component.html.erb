<section class="branches-panel"><div class="branches-heading"><h2>Branches</h2><span><%= @repository.repository_branches.count %> total</span></div><% if @repository.repository_branches.any? %><% @repository.repository_branches.order(protected: :desc, name: :asc).each do |branch| %><a class="branch-row" href="<%= repository_branch_path(@repository.owner.login, @repository.name, branch.name) %>"><span>⌘ <strong><%= branch.name %></strong> <%= "default" if branch.name == @repository.default_branch %></span><code><%= branch.commit_sha.first(7) %></code></a><% end %><% else %><p class="empty">No branches recorded.</p><% end %></section>
