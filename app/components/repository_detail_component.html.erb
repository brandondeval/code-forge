<!doctype html>
<html>
  <head>
    <title><%= @repository.owner.login %>/<%= @repository.name %> · Forge</title>
    <style>
      body { font: 16px/1.5 system-ui, sans-serif; color: #1f2328; margin: 0; } header { background: #24292f; color: white; padding: 1rem max(5vw, 1.5rem); } main { max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem; } a { color: #0969da; text-decoration: none; } .path { color: #57606a; } .metadata { display: flex; gap: 1rem; color: #57606a; border-block: 1px solid #d0d7de; padding: 1rem 0; } .tabs { display: flex; gap: .3rem; border-bottom: 1px solid #d0d7de; margin-top: 1.5rem; } .tab { background: none; border: 0; border-bottom: 2px solid transparent; padding: .65rem .9rem; cursor: pointer; font: inherit; } .tab[aria-selected=true] { border-bottom-color: #fd8c73; font-weight: 650; } .tab-pane { padding-top: 1rem; } .list-panel, .new-pull-request, .errors { border: 1px solid #d0d7de; border-radius: 6px; } .list-panel h2 { font-size: 1rem; padding: .75rem 1rem; margin: 0; border-bottom: 1px solid #d0d7de; } .item { padding: .75rem 1rem; border-bottom: 1px solid #d8dee4; } .item:last-child { border: 0; } .item small { color: #57606a; } .empty { color: #57606a; padding: .75rem 1rem; } .new-pull-request { margin-top: 1.5rem; padding: 1rem; } .new-pull-request h2 { margin-top: 0; font-size: 1.1rem; } form { display: grid; gap: .75rem; } label { display: grid; gap: .3rem; font-weight: 600; font-size: .9rem; } input, textarea { font: inherit; padding: .45rem; border: 1px solid #d0d7de; border-radius: 6px; } textarea { min-height: 5rem; } input[type=submit] { background: #1f883d; color: white; border-color: #1f883d; width: fit-content; cursor: pointer; } .branch-fields { display: grid; grid-template-columns: 1fr auto 1fr; gap: .5rem; align-items: end; } .branch-fields span { padding-bottom: .45rem; } .errors { border-color: #cf222e; background: #ffebe9; padding: .75rem 1rem; margin-top: 1rem; } .errors ul { margin: .4rem 0 0; } .code-overview { position: relative; overflow: visible; color: #c9d1d9; background: #22272e; border: 1px solid #444c56; border-radius: 6px; } .code-overview a { color: #c9d1d9; } .code-toolbar { display: flex; align-items: center; gap: 1.1rem; padding: 1rem; border-bottom: 1px solid #444c56; } .branch-picker, .file-search { padding: .35rem .65rem; border: 1px solid #57606a; border-radius: 6px; } .branch-picker { color: #c9d1d9; background: #2d333b; cursor: pointer; } .file-search { margin-left: auto; min-width: 12rem; color: #8c959f; } .commit-link { color: #58a6ff !important; white-space: nowrap; } .commit-link code { padding: .1rem .3rem; color: #c9d1d9; background: #161b22; border-radius: 4px; } .branch-count { color: #adbac7; } .ref-switcher { position: absolute; z-index: 3; top: 3.5rem; left: .5rem; width: min(29rem, calc(100vw - 3rem)); background: #22272e; border: 1px solid #57606a; border-radius: 8px; box-shadow: 0 8px 24px #0008; overflow: hidden; } .switcher-title { display: flex; justify-content: space-between; align-items: center; padding: 1rem; font-size: 1.1rem; } .switcher-close { color: #8c959f; background: none; border: 0; font: 1.8rem/1 sans-serif; cursor: pointer; } .ref-search { display: block; width: calc(100% - 2rem); margin: 0 1rem .8rem; padding: .6rem .7rem; color: #c9d1d9; background: #1c2128; border: 1px solid #57606a; border-radius: 6px; font: inherit; } .ref-tabs { display: flex; border-block: 1px solid #373e47; } .ref-tab { padding: .7rem 1.2rem; color: #c9d1d9; background: none; border: 0; border-right: 1px solid #373e47; font: inherit; font-weight: 650; cursor: pointer; } .ref-tab[aria-selected=true] { background: #2d333b; } .ref-panel { max-height: 22rem; overflow: auto; padding: .4rem 0; } .ref-panel a, .ref-panel p { display: block; padding: .55rem 1rem; margin: 0; } .ref-panel a:hover { background: #2d333b; } .ref-panel span { float: right; color: #adbac7; border: 1px solid #57606a; border-radius: 999px; padding: 0 .4rem; font-size: .75rem; } .code-workspace { display: grid; grid-template-columns: minmax(17rem, 34%) minmax(0, 1fr); min-height: 31rem; overflow: hidden; border-radius: 0 0 6px 6px; } .file-explorer { border-right: 1px solid #444c56; overflow: auto; } .commit-summary { display: flex; gap: .6rem; align-items: center; padding: .75rem 1rem; border-bottom: 1px solid #444c56; color: #adbac7; font-size: .8rem; } .commit-summary strong { color: #f0f6fc; } .commit-summary code { margin-left: auto; color: #8b949e; } .commit-avatar { color: #a371f7; } .tree-folder, .tree-file { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .5rem; padding: .12rem .65rem .12rem calc(.65rem + var(--tree-depth) * .9rem); border-bottom: 1px solid #373e47; } .tree-folder:hover, .tree-file:hover { background: #2d333b; } .tree-folder time, .tree-file time { color: #8c959f; font-size: .78rem; white-space: nowrap; } .folder-toggle { display: flex; align-items: center; gap: .25rem; min-width: 0; padding: .4rem 0; color: #c9d1d9; text-align: left; font: inherit; background: none; border: 0; cursor: pointer; } .folder-chevron { width: .8rem; color: #8c959f; transition: transform .15s ease; } .folder-toggle[aria-expanded=true] .folder-chevron { transform: rotate(90deg); } .tree-file a { display: flex; align-items: center; gap: .25rem; min-width: 0; padding: .4rem 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; } .file-icon { color: #8c959f; display: inline-block; width: 1.25rem; flex: none; } .empty-files { padding: 1.5rem; margin: 0; color: #adbac7; } .preview-pane { min-width: 0; background: #0d1117; } .preview-empty { height: 100%; min-height: 25rem; display: grid; place-content: center; gap: .6rem; text-align: center; color: #8b949e; padding: 2rem; } .preview-empty span { font-size: 2.5rem; } .preview-empty strong { color: #c9d1d9; } .preview-empty p { margin: 0; max-width: 21rem; } .inline-file-preview { height: 100%; margin: 0; } .preview-header { display: flex; justify-content: space-between; padding: .75rem 1rem; color: #f0f6fc; background: #161b22; border-bottom: 1px solid #30363d; } .preview-header span { color: #8c959f; } .inline-file-preview .highlight { overflow: auto; background: #0d1117; max-height: 38rem; } .inline-file-preview pre { margin: 0; padding: 1rem; font: 13px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; } @media (max-width: 700px) { .branch-fields { grid-template-columns: 1fr; } .branch-fields span, .branch-count, .file-search { display: none; } .code-toolbar { gap: .5rem; } .code-workspace { grid-template-columns: 1fr; } .file-explorer { border-right: 0; border-bottom: 1px solid #444c56; max-height: 20rem; overflow: auto; } .preview-pane { min-height: 20rem; } }
    </style>
  </head>
  <body>
    <header><strong>◈ Forge</strong></header>
    <main>
      <a href="http://localhost:5173">← All repositories</a>
      <h1><span class="path"><a href="http://localhost:5173/users/<%= ERB::Util.url_encode(@repository.owner.login) %>"><%= @repository.owner.login %></a> /</span> <%= @repository.name %></h1>
      <p><%= @repository.description.presence || "No description" %></p>
      <div class="metadata"><span><%= @repository.visibility %> repository</span><span>★ <%= @repository.stars_count %> stars</span></div>
      <div class="tabs" role="tablist"><button class="tab" role="tab" aria-selected="true" aria-controls="overview" id="overview-tab">Code overview</button><button class="tab" role="tab" aria-selected="false" aria-controls="branches" id="branches-tab">Branches</button><button class="tab" role="tab" aria-selected="false" aria-controls="issues" id="issues-tab">Issues</button><button class="tab" role="tab" aria-selected="false" aria-controls="pull-requests" id="pull-requests-tab">Pull requests</button></div>
      <div class="tab-pane" id="overview" role="tabpanel" aria-labelledby="overview-tab"><%= render CodeOverviewComponent.new(repository: @repository, path: @path, file: @file, branch: @branch, tag: @tag) %></div>
      <div class="tab-pane" id="branches" role="tabpanel" aria-labelledby="branches-tab" hidden><%= render BranchesListComponent.new(repository: @repository) %></div>
      <div class="tab-pane" id="issues" role="tabpanel" aria-labelledby="issues-tab" hidden><%= render IssuesListComponent.new(repository: @repository) %></div>
      <div class="tab-pane" id="pull-requests" role="tabpanel" aria-labelledby="pull-requests-tab" hidden><%= render PullRequestsListComponent.new(repository: @repository, pull_request: @pull_request) %></div>
    </main>
    <script>
    document.querySelectorAll('.tab').forEach((tab) => tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
      document.querySelectorAll('.tab-pane').forEach((pane) => { pane.hidden = pane.id !== tab.getAttribute('aria-controls'); });
    }));
    </script>
  </body>
</html>
