<section class="list-panel"><h2>Issues (<%= @repository.issues.count %>)</h2><% if @repository.issues.any? %><% @repository.issues.each do |issue| %><div class="item"><span class="issue-icon"><%= issue.open? ? "●" : "✓" %></span> <strong><%= issue.title %></strong><br><small>opened by <%= issue.author.login %> · <%= issue.state %></small></div><% end %><% else %><p class="empty">No issues yet.</p><% end %></section>
