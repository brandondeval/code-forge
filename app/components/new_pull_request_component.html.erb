<!doctype html><html><head><title>New pull request · <%= @repository.name %> · Forge</title><style>body { margin: 0; color: #1f2328; font: 16px/1.5 system-ui, sans-serif; } header { padding: 1rem max(5vw, 1.5rem); color: white; background: #24292f; } main { max-width: 720px; margin: 2rem auto; padding: 0 1.5rem; } a { color: #0969da; text-decoration: none; } form { display: grid; gap: .8rem; margin-top: 1rem; padding: 1rem; border: 1px solid #d0d7de; border-radius: 6px; } label { display: grid; gap: .3rem; font-weight: 600; } input, textarea { font: inherit; padding: .5rem; border: 1px solid #d0d7de; border-radius: 6px; } textarea { min-height: 7rem; } input[type=submit] { width: fit-content; color: white; background: #1f883d; border-color: #1f883d; cursor: pointer; } .branches { display: grid; grid-template-columns: 1fr auto 1fr; gap: .5rem; align-items: end; }</style></head><body><header><strong>◈ Forge</strong></header><main><a href="<%= repository_path(@repository.owner.login, @repository.name) %>">← <%= @repository.owner.login %>/<%= @repository.name %></a><h1>Open a pull request</h1><%= form_with url: repository_pull_requests_path(@repository.owner.login, @repository.name), scope: :pull_request do |form| %><label>Title <%= form.text_field :title, required: true %></label><label>Description <%= form.text_area :body %></label><div class="branches"><label>Compare branch <%= form.text_field :head_branch, value: @pull_request.head_branch, required: true %></label><span>→</span><label>Base branch <%= form.text_field :base_branch, value: @repository.default_branch, required: true %></label></div><%= form.submit "Create pull request" %><% end %></main></body></html>
