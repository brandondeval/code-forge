<!doctype html>
<html><head><title><%= @branch.name %> · <%= @repository.name %> · Forge</title><style>body { margin: 0; color: #c9d1d9; background: #0d1117; font: 16px/1.5 system-ui, sans-serif; } header { padding: 1rem max(5vw, 1.5rem); background: #161b22; border-bottom: 1px solid #30363d; } main { max-width: 960px; margin: 2rem auto; padding: 0 1.5rem; } a { color: #58a6ff; text-decoration: none; } h1 { color: #f0f6fc; } .branch-card, .commits { border: 1px solid #30363d; border-radius: 6px; background: #161b22; } .branch-card { padding: 1rem; display: flex; align-items: center; gap: 1rem; } .branch-card code { margin-left: auto; color: #58a6ff; } .primary { margin-left: auto; padding: .45rem .75rem; border-radius: 6px; color: white; background: #1f883d; } .commits { margin-top: 1rem; overflow: hidden; } .commit { padding: .8rem 1rem; border-bottom: 1px solid #30363d; } .commit:last-child { border-bottom: 0; } .commit small { color: #8b949e; } .empty { color: #8b949e; padding: 1rem; }</style></head><body><header><strong>◈ Forge</strong></header><main><a href="<%= repository_path(@repository.owner.login, @repository.name) %>">← <%= @repository.owner.login %>/<%= @repository.name %></a><h1>Branch: <%= @branch.name %></h1><section class="branch-card"><span>⌘ <strong><%= @branch.name %></strong> <%= "(default)" if default_branch? %></span><code><%= @branch.commit_sha.first(7) %></code><% unless default_branch? %><a class="primary" href="<%= new_repository_pull_request_path(@repository.owner.login, @repository.name, head_branch: @branch.name) %>">Create pull request</a><% end %></section><section class="commits"><% if @commits.any? %><% @commits.each do |commit| %><div class="commit"><a href="<%= repository_commit_path(@repository.owner.login, @repository.name, commit.sha) %>"><strong><%= commit.message %></strong></a><br><small><%= commit.sha.first(7) %> · <%= time_ago_in_words(commit.created_at) %> ago</small></div><% end %><% else %><p class="empty">No commits recorded for this branch.</p><% end %></section></main></body></html>
