<section class="list-panel"><h2>Pull requests (<%= @repository.pull_requests.count %>)</h2><% if @repository.pull_requests.any? %><% @repository.pull_requests.each do |pull_request| %><div class="item"><a href="<%= repository_pull_request_path(@repository.owner.login, @repository.name, pull_request) %>"><%= pull_request.open? ? "●" : "✓" %> <%= pull_request.title %></a><br><small><%= pull_request.head_branch %> → <%= pull_request.base_branch %> · <%= pull_request.state %></small></div><% end %><% else %><p class="empty">No pull requests yet.</p><% end %></section>
<section class="new-pull-request"><h2>Open a pull request</h2><% if @pull_request.errors.any? %><div class="errors"><strong>Could not create pull request</strong><ul><% @pull_request.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %><%= form_with url: repository_pull_requests_path(@repository.owner.login, @repository.name), scope: :pull_request do |form| %><label>Title <%= form.text_field :title, required: true, placeholder: "Describe the proposed change" %></label><label>Description <%= form.text_area :body, placeholder: "What changed and why?" %></label><div class="branch-fields"><label>Compare branch <%= form.text_field :head_branch, required: true, placeholder: "feature/new-thing" %></label><span>→</span><label>Base branch <%= form.text_field :base_branch, required: true, value: @pull_request.base_branch || @repository.default_branch %></label></div><label>Access token <%= password_field_tag :access_token, nil, required: true, placeholder: "Your local Forge access token" %></label><%= form.submit "Create pull request" %><% end %></section>
